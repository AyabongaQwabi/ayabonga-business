# Site (business.qwabi.co.za)
VITE_SITE_URL=https://business.qwabi.co.za
SITE_URL=https://business.qwabi.co.za

# Resend (quote export + founder nurture + lead notify) — required for /api/send
# Get a key at https://resend.com/api-keys — add to .env.local AND Vercel project env
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Ayabonga Qwabi <onboarding@qwabi.co.za>
NOTIFY_EMAIL=ayabonga@qwabi.co.za
RESEND_AUDIENCE_ID=
RESEND_LEADS_SEGMENT_ID=
RESEND_NURTURE_ENABLED=true

# Vercel Blob (leads admin + capture) — server only, never VITE_
# Create a Blob store in Vercel → Storage → connect to project
BLOB_READ_WRITE_TOKEN=
# Must match your store in Vercel: public or private (default private)
BLOB_ACCESS=public

# Admin portal (/admin)
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Seed script (npm run leads:seed) — bump to re-upload intelligence leads
LEADS_SEED_VERSION=2026-05-16

# Daily outbound worker (/api/cron/outreach-daily) — Vercel cron 06:00 UTC
CRON_SECRET=
OUTREACH_ENABLED=true
OUTREACH_DAILY_MIN=12
OUTREACH_DAILY_MAX=25
# Discovery (set at least one — Brave free tier is ~2k queries/month)
# https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Internal lead emails (WhatsApp prefill in notifications)
WHATSAPP_NUMBER=27603116777

