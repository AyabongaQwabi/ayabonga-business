{
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/pricing-strategy",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
